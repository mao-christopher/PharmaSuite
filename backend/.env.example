# Copy this file to .env and fill in values — never commit .env itself

# YOLO / Ultralytics settings
YOLO_VERBOSE=True
# Pose inference size for uploads (px, long side). 640 is faster; 960 finds distant people.
POSE_IMGSZ=960

# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=pharma-yolo

# Paths (override defaults in src/config.py)
DATA_DIR=data
MODELS_DIR=models
OUTPUTS_DIR=runs

# Authoritative inventory store (required; no JSON fallback)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=pharma
PHARMACY_ID=default

# "Render simulation" (optional): a licensed Unity editor on this machine. Without it the
# button is disabled and says why. The simulation project defaults to ../simulation.
# macOS example: /Applications/Unity/Hub/Editor/6000.6.3f1/Unity.app/Contents/MacOS/Unity
UNITY_PATH=
SIMULATION_DIR=

# Meta Llama API (optional): plans shelf layouts from imported shipments on the Shipments
# page and flags medications that are easy to confuse. Without a token the built-in planner
# applies the same separation rules. Get a key at https://llama.developer.meta.com.
META_API_KEY=
# META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# META_API_BASE_URL=https://api.llama.com/v1
