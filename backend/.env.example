# Copy to backend/.env and adjust. Never commit .env itself.

# Authoritative inventory store (required; there is no file fallback)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=pharma
PHARMACY_ID=default

# Paths relative to backend/ (see src/pharma/config.py)
DATA_DIR=data
MODELS_DIR=models
OUTPUTS_DIR=runs

# Pose inference size for uploads (px, long side). 640 is faster; 960 finds distant people.
POSE_IMGSZ=960
YOLO_VERBOSE=True

# Optional: expiry checks use this date (YYYY-MM-DD) instead of today's date.
# PHARMACY_DATE=

# Optional "Render simulation" button: a licensed Unity editor on this machine. Without it
# the button is disabled and says why. The simulation project defaults to ../simulation.
# macOS example: /Applications/Unity/Hub/Editor/6000.6.3f1/Unity.app/Contents/MacOS/Unity
UNITY_PATH=
SIMULATION_DIR=
