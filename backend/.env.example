# Copy this file to .env and fill in values — never commit .env itself

# YOLO / Ultralytics settings
YOLO_VERBOSE=True

# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=pharma-yolo

# Paths (override defaults in src/config.py)
DATA_DIR=data
MODELS_DIR=models
OUTPUTS_DIR=runs

# Authoritative inventory store (required; no JSON fallback)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=pharma
PHARMACY_ID=default
