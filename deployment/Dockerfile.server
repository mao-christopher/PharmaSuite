FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY backend/dashboard/package*.json ./
RUN npm ci
COPY backend/dashboard/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend/src PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 xvfb xauth libgtk-3-0 libnss3 libasound2 libgbm1 libglu1-mesa libxss1 libxtst6 && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
COPY backend/requirements.txt ./
RUN pip install -r requirements.txt imageio-ffmpeg==0.6.0
COPY backend/src ./src
COPY backend/scripts ./scripts
COPY backend/data ./data
COPY --from=frontend /build/dist ./dashboard/dist
COPY simulation /app/simulation
CMD ["python", "scripts/run_server.py", "--host", "0.0.0.0", "--port", "8000"]
